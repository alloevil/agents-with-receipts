{
  "name": "agents-with-receipts",
  "version": "0.1.0",
  "description": "有据可查的 agentic coding 实践手册 + 四个零依赖 CLI：查 agent 读得懂这个仓库（AGENTS.md 与 agent 基建），查 agent 验得动自己的工作成果（验证回路）",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": {
    "agentsmd-lint": "tools/agentsmd-lint/index.mjs",
    "agents-doctor": "tools/agents-doctor/index.mjs",
    "agents-init": "tools/agents-init/index.mjs",
    "verify-doctor": "tools/verify-doctor/index.mjs"
  },
  "scripts": {
    "test": "node --test",
    "lint:self": "node tools/agentsmd-lint/index.mjs README.md rosetta/README.md practices/*.md",
    "doctor": "node tools/agents-doctor/index.mjs .",
    "verify": "node tools/verify-doctor/index.mjs ."
  }
}
